# Database. Defaults to local SQLite file if unset (see README for why SQLite
# is used for this assessment, and how to switch to Postgres in one line).
# Postgres example: postgresql+psycopg2://booknest:booknest@localhost:5432/booknest
DATABASE_URL=sqlite:///./booknest.db

# JWT secrets - change these in any real deployment
ACCESS_TOKEN_SECRET=dev-access-secret-change-me
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Set to "true" behind HTTPS in production so the refresh cookie is Secure
COOKIE_SECURE=false
